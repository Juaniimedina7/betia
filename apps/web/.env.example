# The Odds API (https://the-odds-api.com) — get a key from the dashboard.
ODDSAPI_API_KEY=
# Optional overrides — defaults to https://api.the-odds-api.com and a 10s request timeout.
ODDSAPI_HOST=
ODDSAPI_TIMEOUT_MS=

# Neon Postgres — provisioned via `vercel integration add neon`, synced with `vercel env pull`.
DATABASE_URL=

# Upstash Redis — provisioned via `vercel integration add upstash`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk — provisioned via `vercel integration add clerk`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# From the Clerk dashboard's webhook endpoint config (points at /api/webhooks/clerk).
CLERK_WEBHOOK_SIGNING_SECRET=

# Internal MCP auth — generate with `openssl rand -hex 32`.
MCP_INTERNAL_JWT_SECRET=

# Vercel Cron auth — Vercel sends `Authorization: Bearer $CRON_SECRET` automatically once this is set.
CRON_SECRET=

# Comma-separated The Odds API sport_keys the ingestion cron polls. Empty = falls back
# to the hardcoded default in apps/web/lib/ingest/watched-sport-keys.ts (13 soccer
# leagues + NBA + NFL, plus up to 2 dynamically-discovered active tennis tournaments —
# an explicit override here skips that tennis auto-discovery). Look up real sport_keys
# with GET /v4/sports.
WATCHED_SPORT_KEYS=

# Comma-separated bookmakers the ingestion cron requests — one call returns all of
# them together (unlike OddsPapi's one-bookmaker-per-call constraint). Empty = falls
# back to the hardcoded default (Pinnacle + Unibet) in apps/web/app/api/ingest/poll/route.ts.
# See GET /v4/sports/{sport}/odds for the full bookmaker list your account can see.
ODDSAPI_BOOKMAKERS=

# AI Gateway — usually unnecessary on Vercel (OIDC via `vercel env pull` handles auth).
# Set this only for local dev outside `vercel dev` / CI.
AI_GATEWAY_API_KEY=

# Mercado Pago subscriptions — from mercadopago.com.ar/developers → Tus integraciones.
# Access token (TEST-... in sandbox, APP_USR-... in production). Unset = checkout disabled.
MP_ACCESS_TOKEN=
# Webhook "clave secreta" (Webhooks → Configurar notificaciones), used to verify x-signature.
MP_WEBHOOK_SECRET=
# Sandbox only: test buyer's email (test_user_<User ID>@testuser.com), used as payer_email
# because MP rejects a real payer with a test seller. Leave unset with production credentials.
MP_SANDBOX_PAYER_EMAIL=
# Sandbox only: webhook secret of the MP app that owns the test seller's token (not the
# main account's app). Both secrets are accepted. Leave unset with production credentials.
MP_SANDBOX_WEBHOOK_SECRET=
