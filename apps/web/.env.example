# OddsPapi (https://oddspapi.io) — get a free-tier key from the dashboard.
ODDSPAPI_API_KEY=
# Optional overrides — defaults to https://api.oddspapi.io and a 10s request timeout.
ODDSPAPI_HOST=
ODDSPAPI_TIMEOUT_MS=

# Neon Postgres — provisioned via `vercel integration add neon`, synced with `vercel env pull`.
DATABASE_URL=

# Upstash Redis — provisioned via `vercel integration add upstash`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk — provisioned via `vercel integration add clerk`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# From the Clerk dashboard's webhook endpoint config (points at /api/webhooks/clerk).
CLERK_WEBHOOK_SIGNING_SECRET=

# Internal MCP auth — generate with `openssl rand -hex 32`.
MCP_INTERNAL_JWT_SECRET=

# Vercel Cron auth — Vercel sends `Authorization: Bearer $CRON_SECRET` automatically once this is set.
CRON_SECRET=

# Comma-separated OddsPapi tournamentIds the ingestion cron polls. Empty = poll no-ops.
# Default set: Champions/Europa League, the big 5 European leagues, Copa Libertadores,
# and Liga Profesional (Argentina). Look up ids with GET /v4/tournaments?sportId=<id>.
WATCHED_TOURNAMENT_IDS=7,679,17,8,23,35,34,384,155

# Reference bookmaker for the ingestion cron — /v4/odds-by-tournaments requires exactly
# one. Pinnacle is used by default for its broad market coverage. See GET /v4/bookmakers
# for the full list of slugs.
ODDSPAPI_BOOKMAKER=pinnacle

# AI Gateway — usually unnecessary on Vercel (OIDC via `vercel env pull` handles auth).
# Set this only for local dev outside `vercel dev` / CI.
AI_GATEWAY_API_KEY=
